# Server Configuration
PORT=3000
NODE_ENV=development
APP_BASE_URL=http://localhost:3000

# Session Security Secret (Generate a strong random string in production)
SESSION_SECRET=change_this_to_a_secure_random_secret_string

# Database Configuration (SQLite database path)
DATABASE_PATH=database/namma_voice.sqlite

# File Upload Limits (in bytes, 5MB default)
MAX_FILE_SIZE=5242880

# Optional Initial Administrator Bootstrapping (leave empty to use 'npm run create-admin')
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=
INITIAL_ADMIN_NAME=

# Authentication email delivery (Resend REST API). Use credentials from your provider.
EMAIL_PROVIDER=resend
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_FROM_NAME=NAMMA VOICE

# Optional. Leave blank to accept any valid email domain; do not set until APS's
# official student email domain has been confirmed.
STUDENT_EMAIL_DOMAINS=
EMAIL_VERIFICATION_ENABLED=false
